<group name="local,soc_rules">

    <!-- =========================
         FREERADIUS RULES
    ========================= -->

    <rule id="110010" level="3">
        <decoded_as>freeradius-parent</decoded_as>
        <match>Login OK</match>
        <description>RADIUS login OK: $(username) from $(authenticator) [$(mac)]</description>
        <group>auth,authentication_success,freeradius,pci_dss_10.2.5,</group>
    </rule>

    <rule id="110011" level="8">
        <decoded_as>freeradius-parent</decoded_as>
        <match>Login incorrect</match>
        <description>RADIUS login FAIL ($(reason)): $(username) from $(authenticator) [$(mac)]</description>
        <group>auth,authentication_fail,freeradius,pci_dss_10.2.4,pci_dss_10.2.5,</group>
    </rule>

    <rule id="110204" level="10" frequency="5" timeframe="120">
        <if_matched_sid>110011</if_matched_sid>
        <same_field>authenticator</same_field>
        <description>FreeRADIUS: Possível ataque de força bruta detectado de $(authenticator) em 120 segundos.</description>
        <mitre>
            <id>T1110.001</id>
        </mitre>
        <group>authentication_failures,attack,freeradius,pci_dss_11.4,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_SI.4,</group>
    </rule>

    <rule id="110030" level="3">
        <decoded_as>json</decoded_as>
        <field name="event">^radius$</field>
        <field name="result">^Access-Accept$</field>
        <description>RADIUS ACCEPT (JSON): User $(dstuser) from $(nas_ip)</description>
        <group>auth,authentication_success,freeradius,radius_json,pci_dss_10.2.5,</group>
    </rule>

    <rule id="110031" level="8">
        <decoded_as>json</decoded_as>
        <field name="event">^radius$</field>
        <field name="result">^Access-Reject$</field>
        <description>RADIUS REJECT (JSON): User $(dstuser) from $(nas_ip). Reason: $(reply_message)</description>
        <group>auth,authentication_fail,freeradius,radius_json,pci_dss_10.2.4,pci_dss_10.2.5,</group>
    </rule>

    <!-- =========================
         RADSECPROXY RULES
    ========================= -->

    <rule id="110101" level="10">
        <decoded_as>radsecproxy-parent</decoded_as>
        <match>TLS handshake failed</match>
        <description>RadSecProxy: TLS handshake failed with peer $(dst_ip).</description>
        <group>radsecproxy,tls,error,service_availability,</group>
    </rule>

    <rule id="110306" level="10" frequency="3" timeframe="300">
        <if_matched_sid>110101</if_matched_sid>
        <description>Radsecproxy: Múltiplas falhas TLS detectadas - possível problema de certificado em 5min.</description>
        <group>tls_error,radsecproxy,pci_dss_10.6.1,gdpr_IV_35.7.d,nist_800_53_SI.4,</group>
    </rule>

    <rule id="110102" level="7">
        <decoded_as>radsecproxy-parent</decoded_as>
        <match>timed out</match>
        <description>RadSecProxy: Connection to server $(dst_ip) timed out.</description>
        <group>radsecproxy,status,error,service_availability,</group>
    </rule>

    <rule id="110103" level="4">
        <decoded_as>radsecproxy-parent</decoded_as>
        <match>status server response</match>
        <description>RadSecProxy: Healthcheck OK for server $(dst_ip).</description>
        <group>radsecproxy,status,healthcheck,</group>
    </rule>


    <rule id="110105" level="3">
        <decoded_as>radsecproxy-parent</decoded_as>
        <match>Access-Accept for user</match>
        <description>RadSecProxy: Access-Accept for user $(username) via $(radius_backend) to $(dst_ip).</description>
        <group>radsecproxy,authentication_success,freeradius,pci_dss_10.2.5,</group>
    </rule>

    <rule id="110106" level="8">
        <decoded_as>radsecproxy-parent</decoded_as>
        <match>Access-Reject for user</match>
        <description>RadSecProxy: Access-Reject for user $(username) via $(radius_backend) to $(dst_ip).</description>
        <group>radsecproxy,authentication_fail,freeradius,pci_dss_10.2.4,pci_dss_10.2.5,</group>
    </rule>
    <rule id="110104" level="3">
        <decoded_as>radsecproxy-parent</decoded_as>
        <description>RadSecProxy: General event.</description>
        <group>radsecproxy,syslog,</group>
        <options>no_full_log</options>
    </rule>

<!-- ========================= 
         SURICATA IDS/IPS RULES
         IDs: 110200-110210 (faixa dedicada)
    ========================= -->
    
    <!-- Suricata Parent Rule - catches all Suricata JSON events from eve.json -->

    <!-- Suricata Alert Rule - catches alert events (IDS detections) -->

    <!-- Suricata Drop Rule - catches IPS blocking events -->

    <!-- =========================
         WIREGUARD VPN RULES
    ========================= -->

    <rule id="111100" level="0" noalert="1">
        <program_name>wireguard-vpn</program_name>
        <description>WireGuard event grouping rule.</description>
    </rule>

    <rule id="110040" level="5">
        <if_sid>111100</if_sid>
        <match>Keypair created for peer</match>
        <description>WireGuard: Successful handshake and session established with peer $(src_ip).</description>
        <group>wireguard_vpn,authentication_success,pci_dss_10.2.5,</group>
    </rule>

    <rule id="110041" level="8">
        <if_sid>111100</if_sid>
        <match>Invalid handshake initiation</match>
        <description>WireGuard: Failed handshake attempt from $(src_ip).</description>
        <group>wireguard_vpn,authentication_fail,pci_dss_10.2.4,</group>
    </rule>

    <rule id="110042" level="3">
        <if_sid>111100</if_sid>
        <match>Zeroing out all keys for peer</match>
        <description>WireGuard: Peer $(src_ip) session expired due to inactivity.</description>
        <group>wireguard_vpn,session_end,</group>
    </rule>


    <!-- =========================
         VERACRYPT RULES
    ========================= -->

    <rule id="111103" level="0" noalert="1">
        <program_name>veracrypt-mount</program_name>
        <description>VeraCrypt mount event grouping rule.</description>
    </rule>

    <rule id="111104" level="0" noalert="1">
        <program_name>veracrypt-dismount</program_name>
        <description>VeraCrypt dismount event grouping rule.</description>
    </rule>

    <rule id="110060" level="5">
        <if_sid>111103</if_sid>
        <match>Success</match>
        <description>VeraCrypt: Volume mounted successfully.</description>
        <group>veracrypt,mount_success,pci_dss_10.2.5,</group>
    </rule>

    <rule id="110061" level="7">
        <if_sid>111103</if_sid>
        <match>Failed</match>
        <description>VeraCrypt: Failed to mount volume.</description>
        <group>veracrypt,mount_failure,pci_dss_10.2.4,</group>
    </rule>

    <rule id="110062" level="4">
        <if_sid>111104</if_sid>
        <match>Success</match>
        <description>VeraCrypt: Volume unmounted successfully.</description>
        <group>veracrypt,umount_success,pci_dss_10.2.5,</group>
    </rule>

    <rule id="110063" level="7">
        <if_sid>111104</if_sid>
        <match>Failed</match>
        <description>VeraCrypt: Failed to unmount volume.</description>
        <group>veracrypt,umount_failure,pci_dss_10.2.4,</group>
    </rule>

    <rule id="110064" level="10" frequency="3" timeframe="60">
        <if_matched_sid>110061</if_matched_sid>
        <same_location />
        <description>VeraCrypt: Multiple mount failures detected (3 in 60s) - possible brute force.</description>
        <mitre>
            <id>T1110</id>
        </mitre>
        <group>veracrypt,brute_force,pci_dss_11.4,</group>
    </rule>

    <!-- =========================
         NWIPE RULES
    ========================= -->

    <rule id="111102" level="0" noalert="1">
        <program_name>nwipe</program_name>
        <description>NWipe event grouping rule.</description>
    </rule>

    <rule id="110065" level="5">
        <if_sid>111102</if_sid>
        <match>status: Erased</match>
        <description>NWipe: Secure erase completed successfully on device $(device).</description>
        <group>nwipe,forensics,data_sanitization,gdpr_IV_17,</group>
    </rule>

    <rule id="110066" level="10">
        <if_sid>111102</if_sid>
        <match>status: FAILED</match>
        <description>NWipe: Secure erase FAILED on device $(device). Physical destruction may be required.</description>
        <group>nwipe,forensics,data_sanitization,error,</group>
    </rule>
    <rule id="110067" level="6">
        <if_sid>111102</if_sid>
        <match>status: UABORTED</match>
        <description>NWipe: Secure erase was aborted by user on device $(device).</description>
        <group>nwipe,forensics,data_sanitization,</group>
    </rule>

    <!-- =========================
         RESTIC BACKUP RULES
    ========================= -->

    <rule id="110006" level="0" noalert="1">
        <program_name>restic</program_name>
        <description>Restic event grouping rule.</description>
    </rule>

    <rule id="110070" level="9">
        <if_sid>110006</if_sid>
        <match>^error:</match>
        <description>Restic: Backup job failed with error: $(error_message).</description>
        <group>restic,backup,error,service_availability,</group>
    </rule>

    <rule id="110071" level="4">
        <if_sid>110006</if_sid>
        <match>^snapshot \w+ saved</match>
        <description>Restic: Backup completed successfully. Snapshot ID: $(id).</description>
        <group>restic,backup,backup_success,</group>
        <options>no_full_log</options>
    </rule>

    <!-- =========================
         CALDERA RULES
    ========================= -->

    <rule id="110008" level="6">
        <if_group>json</if_group>
        <program_name>caldera</program_name>
        <description>Caldera Adversary Emulation: Operation [$(operation.name)] executed TTP [$(attack.tactic)/$(attack.technique_id)] with status [$(status)].</description>
        <group>caldera,adversary_emulation,mitre_attack,</group>
    </rule>
    <!-- =========================
         WAZUH MANAGER RULES
    ========================= -->

    <rule id="110013" level="0" noalert="1">
        <program_name>wazuh-manager</program_name>
        <description>Wazuh Manager event grouping.</description>
    </rule>

    <rule id="110090" level="9">
        <if_sid>110013</if_sid>
        <match>wazuh-remoted|ossec-remoted|ERROR: Too many agents</match>
        <description>Wazuh Manager: Approaching maximum agent limit.</description>
        <group>wazuh_manager,health_check,service_availability,</group>
    </rule>

    <!-- =========================
         WAZUH INDEXER RULES
    ========================= -->

    <rule id="110014" level="0" noalert="1">
        <program_name>wazuh-indexer</program_name>
        <description>Wazuh Indexer event grouping.</description>
    </rule>

    <rule id="110091" level="10">
        <if_sid>110014</if_sid>
        <match>cluster state red</match>
        <description>Wazuh Indexer: Cluster health is RED. Data loss is possible.</description>
        <group>wazuh_indexer,health_check,service_availability,</group>
    </rule>

    <rule id="110092" level="7">
        <if_sid>110014</if_sid>
        <match>cluster state yellow</match>
        <description>Wazuh Indexer: Cluster health is YELLOW. Unassigned shards detected.</description>
        <group>wazuh_indexer,health_check,service_availability,</group>
    </rule>

    <!-- =========================
         WAZUH DASHBOARD RULES
    ========================= -->

    <rule id="110015" level="0" noalert="1">
        <program_name>wazuh-dashboard</program_name>
        <description>Wazuh Dashboard event grouping.</description>
    </rule>

    <rule id="110093" level="7">
        <if_sid>110015</if_sid>
        <match>Unable to connect to Wazuh API</match>
        <description>Wazuh Dashboard: Cannot connect to the Wazuh API.</description>
        <group>wazuh_dashboard,health_check,service_availability,</group>
    </rule>

    <!-- =========================
         FILEBEAT RULES
    ========================= -->

    <rule id="110016" level="0" noalert="1">
        <program_name>filebeat</program_name>
        <description>Filebeat event grouping.</description>
    </rule>

    <rule id="110094" level="8">
        <if_sid>110016</if_sid>
        <match>Connecting to output failed</match>
        <description>Filebeat: Failed to connect to output (Logstash/Indexer). Log shipping is interrupted.</description>
        <group>filebeat,health_check,service_availability,</group>
    </rule>

    <!-- =========================
         ZEEK RULES
         Estratégia: casar por campo "zeek":"true" e categorizar por location do arquivo.
    ========================= -->

    <!-- Agrupamento: qualquer JSON do Zeek -->
    <rule id="100050" level="0" noalert="1">
        <if_group>json</if_group>
        <field name="zeek">^true$</field>
        <description>Zeek: Evento detectado (Agrupamento)</description>
        <group>zeek,network,</group>
    </rule>

    <!-- CONN -->
    <rule id="100051" level="3">
        <if_sid>100050</if_sid>
        <location>^/opt/zeek/logs/current/conn\.log$</location>
        <field name="conn_state">.+</field>
        <description>Zeek: Conexão - $(id_orig_h):$(id_orig_p) -> $(id_resp_h):$(id_resp_p) proto=$(proto) service=$(service) state=$(conn_state)</description>
        <group>zeek,network,conn,</group>
    </rule>

    <!-- DNS -->
    <rule id="100052" level="3">
        <if_sid>100050</if_sid>
        <location>^/opt/zeek/logs/current/dns\.log$</location>
        <field name="query">.+</field>
        <description>Zeek: DNS - src=$(id_orig_h) query=$(query) qtype=$(qtype_name) rcode=$(rcode_name)</description>
        <group>zeek,network,dns,</group>
    </rule>

    <!-- HTTP -->
    <rule id="100053" level="3">
        <if_sid>100050</if_sid>
        <location>^/opt/zeek/logs/current/http\.log$</location>
        <field name="method">.+</field>
        <field name="host">.+</field>
        <description>Zeek: HTTP - src=$(id_orig_h) $(method) $(host)$(uri) status=$(status_code)</description>
        <group>zeek,network,http,</group>
    </rule>

    <!-- SSL/TLS -->
    <rule id="100054" level="3">
        <if_sid>100050</if_sid>
        <location>^/opt/zeek/logs/current/ssl\.log$</location>
        <field name="server_name">.+</field>
        <description>Zeek: SSL - src=$(id_orig_h) sni=$(server_name) version=$(version) cipher=$(cipher)</description>
        <group>zeek,network,ssl,</group>
    </rule>

    <!-- NOTICE -->
    <rule id="100055" level="5">
        <if_sid>100050</if_sid>
        <location>^/opt/zeek/logs/current/notice\.log$</location>
        <field name="note">.+</field>
        <description>Zeek: Notice - note=$(note) msg="$(msg)" src=$(id_orig_h) dst=$(id_resp_h)</description>
        <group>zeek,network,notice,anomaly,</group>
    </rule>

    <!-- Opcional: suprimir o fallback 1002 para eventos do Zeek que não casarem em regras específicas -->
    <rule id="100049" level="0" noalert="1">
        <if_sid>1002</if_sid>
        <field name="zeek">^true$</field>
        <description>Zeek: Suprimir fallback 1002</description>
        <group>zeek,</group>
    </rule>

    <!-- =========================
     UFW FIREWALL RULES (CORRIGIDO)
     Usa if_sid=4100 em vez de decoded_as
    ========================= -->

    <rule id="100100" level="3">
        <if_sid>4100</if_sid>
        <match>[UFW</match>
        <description>UFW: Evento de firewall detectado</description>
        <group>firewall,ufw,</group>
    </rule>

    <rule id="100101" level="5">
        <if_sid>100100</if_sid>
        <action>BLOCK</action>
        <description>UFW BLOCK: Tráfego bloqueado</description>
        <group>firewall_drop,pci_dss_10.6.1,gdpr_IV_35.7.d,</group>
    </rule>

    <rule id="100102" level="10" frequency="10" timeframe="60">
        <if_matched_sid>100101</if_matched_sid>
        <same_source_ip />
        <description>UFW: Possível Port Scan detectado - múltiplos bloqueios em 60s</description>
        <mitre><id>T1046</id></mitre>
        <group>firewall_drop,attacks,reconnaissance,pci_dss_11.4,</group>
   </rule>

   <rule id="100103" level="8">
       <if_sid>100101</if_sid>
       <match>DPT=22</match>
       <description>UFW: Bloqueio em porta SSH (22)</description>
       <mitre><id>T1110</id></mitre>
       <group>firewall_drop,attacks,administrative_port,</group>
   </rule>

   <rule id="100104" level="8">
       <if_sid>100101</if_sid>
       <match>DPT=3389</match>
       <description>UFW: Bloqueio em porta RDP (3389)</description>
       <mitre><id>T1110</id></mitre>
       <group>firewall_drop,attacks,administrative_port,</group>
   </rule>

   <rule id="100105" level="2">
       <if_sid>100100</if_sid>
       <action>ALLOW</action>
       <description>UFW ALLOW: Tráfego permitido</description>
       <group>firewall_allow,</group>
   </rule>

   <rule id="100106" level="1">
       <if_sid>100100</if_sid>
       <action>AUDIT</action>
       <description>UFW AUDIT: Evento de auditoria</description>
       <group>firewall_audit,</group>
   </rule>

   <rule id="100107" level="7">
       <if_sid>100100</if_sid>
       <action>LIMIT</action>
       <description>UFW LIMIT: Rate-limiting aplicado</description>
       <mitre><id>T1499</id></mitre>
       <group>firewall_drop,rate_limit,dos,</group>
   </rule>


    <!-- =========================
         WIREGUARD: UFW TRAFFIC ON WG0 INTERFACE
         Architecture: child rules of existing UFW chain (100101/100105/100106)
         This avoids rule competition with built-in firewall rule 4100
    ========================= -->

    <rule id="112501" level="8">
        <if_sid>100101</if_sid>
        <match>IN=wg0|OUT=wg0</match>
        <description>WireGuard: UFW blocked traffic on wg0 — $(srcip):$(srcport) to $(dstip):$(dstport) proto=$(protocol).</description>
        <group>wireguard_vpn,firewall_drop,network,attack,</group>
    </rule>

    <rule id="112502" level="3">
        <if_sid>100105</if_sid>
        <match>IN=wg0|OUT=wg0</match>
        <description>WireGuard: UFW allowed traffic on wg0 — $(srcip):$(srcport) to $(dstip):$(dstport) proto=$(protocol).</description>
        <group>wireguard_vpn,firewall_allow,network,</group>
    </rule>

    <rule id="112503" level="4">
        <if_sid>100106</if_sid>
        <match>IN=wg0|OUT=wg0</match>
        <description>WireGuard: UFW audit event on wg0 — $(srcip):$(srcport) to $(dstip):$(dstport) proto=$(protocol).</description>
        <group>wireguard_vpn,firewall_audit,network,</group>
    </rule>

    <rule id="112504" level="10" frequency="10" timeframe="60">
        <if_matched_sid>112501</if_matched_sid>
        <same_source_ip />
        <description>WireGuard: Possible scan or abuse via wg0 (multiple blocked events in 60s).</description>
        <mitre>
            <id>T1046</id>
        </mitre>
        <group>wireguard_vpn,attack,reconnaissance,</group>
    </rule>

    <!-- =========================
         WIREGUARD: WG-QUICK SERVICE LIFECYCLE
    ========================= -->

    <rule id="112505" level="0" noalert="1">
        <program_name>wg-quick</program_name>
        <description>WireGuard wg-quick service event grouping.</description>
    </rule>

    <rule id="112506" level="3">
        <if_sid>112505</if_sid>
        <match>ip link add|ip link set</match>
        <description>WireGuard: Interface wg0 brought up via wg-quick.</description>
        <group>wireguard_vpn,service_start,</group>
    </rule>

    <rule id="112507" level="5">
        <if_sid>112505</if_sid>
        <match>ip link delete</match>
        <description>WireGuard: Interface wg0 brought down via wg-quick.</description>
        <group>wireguard_vpn,service_stop,</group>
    </rule>

</group>

<!-- MISP Threat Intelligence Integration Rules -->
<group name="misp,threat_intel,">

  <rule id="100700" level="0">
    <field name="integration">misp</field>
    <description>MISP integration event received</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100701" level="12">
    <if_sid>100700</if_sid>
    <field name="misp.value">\S+</field>
    <description>MISP: Threat intel match - $(misp.type) $(misp.value) [event $(misp.event_id): $(misp.event_info)]</description>
    <options>no_full_log</options>
    <mitre>
      <id>T1071</id>
    </mitre>
    <group>misp_alert,</group>
  </rule>

</group>

<!-- ======================== OSINT CDB THREAT INTELLIGENCE ======================== -->
<group name="osint,threat_intel,cdb_list,malicious_ip,">

  <!-- Parent candidate rule: JSON event eligible for source IP CDB correlation. -->
  <rule id="113100" level="0" noalert="1">
    <decoded_as>json</decoded_as>
    <description>OSINT CDB: JSON source IP correlation candidate.</description>
    <group>osint,threat_intel,cdb_list,srcip,</group>
  </rule>

  <!-- Child rule: source IP appears in the OSINT CDB list. -->
  <rule id="113101" level="12">
    <if_sid>113100</if_sid>
    <list field="srcip" lookup="address_match_key">etc/lists/osint/osint_ipv4_reputation</list>
    <description>OSINT CDB: malicious source IP detected - $(srcip).</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>osint,threat_intel,cdb_list,malicious_ip,malicious_srcip,reconnaissance,</group>
  </rule>

  <!-- Parent candidate rule: JSON event eligible for destination IP CDB correlation. -->
  <rule id="113102" level="0" noalert="1">
    <decoded_as>json</decoded_as>
    <description>OSINT CDB: JSON destination IP correlation candidate.</description>
    <group>osint,threat_intel,cdb_list,dstip,</group>
  </rule>

  <!-- Child rule: destination IP appears in the OSINT CDB list. -->
  <rule id="113103" level="12">
    <if_sid>113102</if_sid>
    <list field="dstip" lookup="address_match_key">etc/lists/osint/osint_ipv4_reputation</list>
    <description>OSINT CDB: malicious destination IP detected - $(dstip).</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <group>osint,threat_intel,cdb_list,malicious_ip,malicious_dstip,command_and_control,</group>
  </rule>

</group>
