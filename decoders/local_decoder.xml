<!-- =========================
 RADSECPROXY DECODERS
========================= -->
<decoder name="radsecproxy-parent">
  <program_name>radsecproxy</program_name>
</decoder>

<decoder name="radsecproxy-parent">
  <prematch>Access-Accept for user|Access-Reject for user|TLS handshake failed|timed out|status server response|createlistener</prematch>
</decoder>


<decoder name="radsecproxy-tlsfail">
  <parent>radsecproxy-parent</parent>
  <prematch>TLS handshake failed with</prematch>
  <regex>TLS handshake failed with (\S+)</regex>
  <order>dst_ip</order>
</decoder>

<decoder name="radsecproxy-timeout">
  <parent>radsecproxy-parent</parent>
  <prematch>Connecting to server</prematch>
  <regex>Connecting to server (\S+) timed out</regex>
  <order>dst_ip</order>
</decoder>

<decoder name="radsecproxy-status-ok">
  <parent>radsecproxy-parent</parent>
  <prematch>Received status server response from</prematch>
  <regex>Received status server response from (\S+)</regex>
  <order>dst_ip</order>
</decoder>

<decoder name="radsecproxy-status-ok-file">
  <parent>radsecproxy-parent</parent>
  <prematch>got status server response from</prematch>
  <regex>got status server response from (\S+)</regex>
  <order>dst_ip</order>
</decoder>

<decoder name="radsecproxy-access-accept">
  <parent>radsecproxy-parent</parent>
  <prematch>Access-Accept for user</prematch>
  <regex type="pcre2">Access-Accept for user (\S+) from (\S+) to (\S+)</regex>
  <order>username,radius_backend,dst_ip</order>
</decoder>

<decoder name="radsecproxy-access-reject">
  <parent>radsecproxy-parent</parent>
  <prematch>Access-Reject for user</prematch>
  <regex type="pcre2">Access-Reject for user (\S+) from (\S+) to (\S+)</regex>
  <order>username,radius_backend,dst_ip</order>
</decoder>

<!-- ========================================================
 UFW DECODERS (SIBLING PATTERN - Kernel 6.14)
 Autor: Bruno Flausino
 Data: 2026-01-09
======================================================== -->

<decoder name="ufw-custom">
  <parent>kernel</parent>
  <type>firewall</type>
  <use_own_name>true</use_own_name>
  <prematch type="pcre2">\[UFW \w+\]</prematch>
  <regex type="pcre2">\[UFW (\w+)\]</regex>
  <order>action</order>
</decoder>

<decoder name="ufw-custom">
  <parent>kernel</parent>
  <regex type="pcre2">SRC=(\S+)</regex>
  <order>srcip</order>
</decoder>

<decoder name="ufw-custom">
  <parent>kernel</parent>
  <regex type="pcre2">DST=(\S+)</regex>
  <order>dstip</order>
</decoder>

<decoder name="ufw-custom">
  <parent>kernel</parent>
  <regex type="pcre2">SPT=(\d+)</regex>
  <order>srcport</order>
</decoder>

<decoder name="ufw-custom">
  <parent>kernel</parent>
  <regex type="pcre2">DPT=(\d+)</regex>
  <order>dstport</order>
</decoder>

<decoder name="ufw-custom">
  <parent>kernel</parent>
  <regex type="pcre2">PROTO=(\w+)</regex>
  <order>protocol</order>
</decoder>

<decoder name="conpot-json-standalone">
  <prematch type="pcre2">^\{"program_name":"conpot".*"log":"\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2},\d{3} New (?:http|modbus|s7comm|snmp|ftp|bacnet|enip|tftp|ipmi) (?:session|connection) from </prematch>
  <regex type="pcre2">^\{"program_name":"conpot".*"log":"(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2},\d{3}) New (\w+) (?:session|connection) from (\d+\.\d+\.\d+\.\d+)(?::(\d+))? \(([^)]+)\)</regex>
  <order>conpot.timestamp,conpot.protocol,srcip,srcport,conpot.session_id</order>
</decoder>

<decoder name="conpot-plain">
  <use_own_name>true</use_own_name>
  <prematch type="pcre2">^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2},\d{3} New (?:http|modbus|s7comm|snmp|ftp|bacnet|enip|tftp|ipmi) (?:session|connection) from </prematch>
  <regex type="pcre2">^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2},\d{3}) New (\w+) (?:session|connection) from (\d+\.\d+\.\d+\.\d+)(?::(\d+))? \(([^)]+)\)</regex>
  <order>conpot.timestamp,conpot.protocol,srcip,srcport,conpot.session_id</order>
</decoder>

