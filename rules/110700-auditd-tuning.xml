  <!-- Catch-all: suppress 110706 from non-root users (auid >= 1000) -->
  <!-- Real SUID escalation requires root context; user-level chmod is desktop noise -->
  <rule id="110770" level="0">
    <if_sid>110706</if_sid>
    <field name="audit.auid" type="pcre2">^\d{4,}$</field>
    <description>Tuning: T1548.001 suppressed - non-root user chmod</description>
