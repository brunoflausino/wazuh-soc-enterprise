<!--
  GNN Security Detector - Wazuh Rules
  Faixa: 100630-100650
  Motivo: 100600-100607 pertencem ao Falco neste ambiente.
  Discriminador: gnn_source == "gnn-detector" no JSON top-level.
  Decoder: JSON nativo do Wazuh via <decoded_as>json</decoded_as>.
-->
<group name="gnn,anomaly,ml,">

  <rule id="100630" level="0">
    <decoded_as>json</decoded_as>
    <field name="gnn_source">gnn-detector</field>
    <description>GNN: evento base (no alert)</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100631" level="10">
    <if_sid>100630</if_sid>
    <field name="detection_type">potential_scanner</field>
    <description>GNN: possivel scanner de rede - $(src_ip)</description>
    <mitre>
      <id>T1046</id>
      <id>T1595</id>
    </mitre>
    <group>recon,scanner,</group>
  </rule>

  <rule id="100632" level="12">
    <if_sid>100630</if_sid>
    <field name="detection_type">potential_c2_server</field>
    <description>GNN: possivel servidor C2 - $(src_ip)</description>
    <mitre>
      <id>T1071</id>
      <id>T1102</id>
      <id>T1573</id>
    </mitre>
    <group>c2,command_control,</group>
  </rule>

  <rule id="100633" level="11">
    <if_sid>100630</if_sid>
    <field name="detection_type">high_severity_source</field>
    <description>GNN: IP com alto volume de alertas criticos - $(src_ip)</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>high_risk,</group>
  </rule>

  <rule id="100634" level="9">
    <if_sid>100630</if_sid>
    <field name="detection_type">high_volume_traffic</field>
    <description>GNN: volume de trafego anomalo - $(src_ip)</description>
    <mitre>
      <id>T1498</id>
    </mitre>
    <group>traffic_anomaly,</group>
  </rule>

  <rule id="100635" level="8">
    <if_sid>100630</if_sid>
    <field name="detection_type">suspicious_pattern</field>
    <description>GNN: padrao de comunicacao suspeito - $(src_ip)</description>
    <mitre>
      <id>T1570</id>
    </mitre>
    <group>suspicious,</group>
  </rule>

  <rule id="100640" level="14">
    <if_sid>100630</if_sid>
    <field name="gnn_score" type="pcre2">^-(0\.[7-9]|1\.0)</field>
    <description>GNN CRITICO: anomalia severa (score $(gnn_score)) - $(src_ip)</description>
    <mitre>
      <id>T1570</id>
      <id>T1021</id>
    </mitre>
    <group>critical,lateral_movement,</group>
  </rule>

  <rule id="100650" level="13" frequency="5" timeframe="3600">
    <if_matched_group>gnn</if_matched_group>
    <same_field>src_ip</same_field>
    <description>GNN: multiplas anomalias do mesmo IP em 1h - $(src_ip)</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>repeated_anomaly,</group>
  </rule>

</group>
